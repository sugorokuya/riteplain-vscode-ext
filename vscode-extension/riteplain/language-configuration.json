{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["[", "]"],
    ["[[", "]]"],
    ["[[[", "]]]"],
    ["link:", "]"],
    ["video:", "]"],
    ["image::", "]"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "[[", "close": "]]" },
    { "open": "[[[", "close": "]]]" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["[[", "]]"],
    ["[[[", "]]]"],
    ["'", "'"],
    ["\"", "\""]
  ],
  "wordPattern": "[^\\s]+",
  "folding": {
    "markers": {
      "start": "^\\s*#\\s",
      "end": "^\\s*$"
    }
  }
}
